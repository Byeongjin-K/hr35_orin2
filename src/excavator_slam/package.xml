<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>excavator_slam</name>
  <version>0.0.1</version>
  <description>LiDAR-inertial (+GNSS) SLAM integration for the HR35 excavator: bag replay, SLAM launch wrappers, and revisit-consistency evaluation.</description>
  <maintainer email="kimbj0607@gmail.com">Byeongjin Kim</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>msg_gps_interface</depend>
  <depend>msg_excavator_kine_interface</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
