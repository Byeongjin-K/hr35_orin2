<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>excavator_msgs</name>
  <version>1.0.0</version>
  <description>
    Excavator Message Interfaces Package for ROS2
    
    This package provides custom message, service, and action definitions
    for excavator control and sensor data management systems.
  </description>
  
  <maintainer email="excavator@example.com">Excavator Control Team</maintainer>
  <license>MIT</license>
  
  <url type="website">https://github.com/excavator-control/excavator_msgs</url>
  <url type="bugtracker">https://github.com/excavator-control/excavator_msgs/issues</url>
  <url type="repository">https://github.com/excavator-control/excavator_msgs</url>
  
  <author email="excavator@example.com">Excavator Control Team</author>
  
  <!-- Build Dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  
  <!-- Message Generation Dependencies -->
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  
  <!-- Runtime Dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  
  <!-- Test Dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <!-- Export Member Summary -->
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package> 