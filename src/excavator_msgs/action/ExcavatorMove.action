# 굴삭기 이동 액션 목표

# 목표 타입 (0: 절대 위치, 1: 상대 위치, 2: 궤적 추종)
uint8 goal_type

# 목표 관절 각도 (degree)
float32 target_boom_angle
float32 target_arm_angle
float32 target_bucket_angle
float32 target_swing_angle

# 목표 위치 (작업 좌표계)
geometry_msgs/Point target_position

# 이동 속도 (0.0 ~ 1.0)
float32 movement_speed

# 정밀도 요구사항 (degree)
float32 position_tolerance

# 최대 실행 시간 (초)
float32 max_execution_time

# 안전 제약 조건
bool enable_collision_avoidance
bool enable_stability_check

---

# 굴삭기 이동 액션 결과

# 이동 성공 여부
bool success

# 최종 관절 각도
float32 final_boom_angle
float32 final_arm_angle
float32 final_bucket_angle
float32 final_swing_angle

# 최종 위치
geometry_msgs/Point final_position

# 실행 시간 (초)
float32 execution_time

# 결과 메시지
string result_message

# 에러 코드 (성공시 0)
uint8 error_code

---

# 굴삭기 이동 액션 피드백

# 현재 진행률 (0.0 ~ 1.0)
float32 progress

# 현재 관절 각도
float32 current_boom_angle
float32 current_arm_angle
float32 current_bucket_angle
float32 current_swing_angle

# 현재 위치
geometry_msgs/Point current_position

# 목표까지 남은 거리/각도
float32 remaining_distance
float32 remaining_angle

# 예상 완료 시간 (초)
float32 estimated_completion_time

# 현재 상태 메시지
string status_message 