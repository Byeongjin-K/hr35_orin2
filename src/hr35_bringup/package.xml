<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hr35_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package for HR35 Orin2 — launch files and configs for sensors</description>
  <maintainer email="kimbj0607@gmail.com">Byeongjin Kim</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
